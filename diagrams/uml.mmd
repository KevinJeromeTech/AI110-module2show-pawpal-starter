classDiagram
    %% Phase 1 draft: the four core classes before implementation.

    class Owner {
        +str name
        +str day_start
        +str day_end
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +mark_task_complete(title: str) Task
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str time
        +str frequency
        +bool completed
        +date due_date
        +is_due_on(day: date) bool
        +mark_complete() Task
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +find_conflicts(tasks) list~str~
        +build_plan(day: date)
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : reads tasks from